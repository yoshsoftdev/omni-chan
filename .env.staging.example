# Staging VM: copy to /srv/omni-chan/.env (chmod 600). Read by docker compose on the VM.
# Generate secrets with: openssl rand -hex 32   (META_TOKEN_ENCRYPTION_KEY: openssl rand -base64 32)

# development = debug logs + relaxed dev defaults; staging = info logs, same checks as production.
APP_ENV=staging

POSTGRES_PASSWORD=
INTERNAL_SERVICE_TOKEN=
MEDIA_TOKEN_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public HTTPS base of the webhook domain (what Meta/Telegram call), e.g. https://hook-stag.example.com
WEBHOOK_PUBLIC_BASE_URL=

META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_CONFIG_ID=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
META_TOKEN_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
OTP_DEFAULT_DEVICE_SLUG=dgos-waba

# Grafana at 127.0.0.1:3001 on the VM (SSH tunnel). Required while OBSERVABILITY=1.
GRAFANA_ADMIN_PASSWORD=
